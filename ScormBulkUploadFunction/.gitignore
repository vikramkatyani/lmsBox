## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Azure Functions
bin/
obj/
.azurefunctions/
__blobstorage__/
__queuestorage__/
__azurite_db*__.json
.python_packages/

# User-specific files
*.user
*.userosscache
*.sln.docstates
local.settings.json
service-account-key.json

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vs/
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Temp files
*.tmp
*.temp
*.log
